{
  "openapi": "3.1.0",
  "info": {
    "title": "Hearthline Public API",
    "version": "1.0.0",
    "description": "Find verified families' Rebuild Registries and local businesses' Reopen Funds after a disaster, check essential prices against their pre-disaster baseline, and prepare gifts. Preparing a gift returns a PayPal approval link: a person approves every payment, nothing is charged before that. The same operations are MCP tools at /mcp.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://hearthline-api.onrender.com",
      "description": "Hosted demo (PayPal sandbox)"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Public API v1",
      "description": "No login needed."
    }
  ],
  "paths": {
    "/v1/disasters": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "List Disasters",
        "description": "Disasters Hearthline is responding to.",
        "operationId": "listDisasters",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Disaster"
                  },
                  "type": "array",
                  "title": "Response Listdisasters"
                }
              }
            }
          }
        }
      }
    },
    "/v1/registries": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Find Registries",
        "description": "Families' verified Rebuild Registries, those that still need the most first.",
        "operationId": "findRegistries",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Words in the title, story or items, e.g. 'mattress'",
              "title": "Q"
            },
            "description": "Words in the title, story or items, e.g. 'mattress'"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RegistrySummary"
                  },
                  "title": "Response Findregistries"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/registries/{slug}": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Get Registry",
        "description": "A registry with every item and what it still needs.",
        "operationId": "getRegistry",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistryDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/registries/{slug}/donations": {
      "post": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Prepare Donation",
        "description": "Prepare a gift to a family. Returns a PayPal link the donor opens to approve it.",
        "operationId": "prepareDonation",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DonationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Checkout"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/donations/{donation_id}": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Get Donation",
        "description": "Where a gift went: paid, item bought, shipped, delivered.",
        "operationId": "getDonation",
        "parameters": [
          {
            "name": "donation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Donation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DonationStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reopen-funds": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "List Reopen Funds",
        "description": "Local businesses selling gift cards to pay for reopening.",
        "operationId": "listReopenFunds",
        "parameters": [
          {
            "name": "include_closed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Closed"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReopenFund"
                  },
                  "title": "Response Listreopenfunds"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reopen-funds/{slug}": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Get Reopen Fund",
        "operationId": "getReopenFund",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReopenFund"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reopen-funds/{slug}/gift-cards": {
      "post": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Prepare Gift Card",
        "description": "Prepare a gift card purchase. Returns a PayPal link the buyer opens to approve it.",
        "operationId": "prepareGiftCard",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GiftCardRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Checkout"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gift-cards/{code}": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Get Gift Card",
        "operationId": "getGiftCard",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiftCardStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/price-watch": {
      "get": {
        "tags": [
          "Public API v1"
        ],
        "summary": "Price Watch",
        "description": "Essential prices against their pre-disaster baseline (California's 10% limit).",
        "operationId": "getPriceWatch",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ok",
                    "gouging",
                    "no_baseline",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PriceReport"
                  },
                  "title": "Response Getpricewatch"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Checkout": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Donation or gift card id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id",
            "description": "PayPal order id"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          },
          "approval_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Url",
            "description": "Open this to approve the payment with PayPal"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url",
            "description": "API URL to check the payment's status"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "A person must approve this payment with PayPal. Nothing is charged until they do."
          }
        },
        "type": "object",
        "required": [
          "id",
          "order_id",
          "amount",
          "approval_url",
          "status_url"
        ],
        "title": "Checkout",
        "description": "A prepared payment. Nothing is charged until a person approves it at `approval_url`."
      },
      "Disaster": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug",
            "examples": [
              "sablewood-fire"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Sablewood Fire"
            ]
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "examples": [
              "wildfire"
            ]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "active"
            ]
          },
          "declared_at": {
            "type": "string",
            "format": "date-time",
            "title": "Declared At"
          },
          "price_protection_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Protection Until",
            "description": "Prices of essentials may rise at most 10% until then"
          },
          "is_fictional": {
            "type": "boolean",
            "title": "Is Fictional"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "kind",
          "status",
          "declared_at",
          "price_protection_until",
          "is_fictional"
        ],
        "title": "Disaster"
      },
      "DonationRequest": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount",
            "description": "USD",
            "examples": [
              50
            ]
          },
          "item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id",
            "description": "A registry item; omit to give to the household fund"
          },
          "donor_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Donor Name",
            "description": "Shown to the family"
          },
          "message": {
            "type": "string",
            "maxLength": 280,
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "DonationRequest"
      },
      "DonationStatus": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "created (waiting for approval) | captured | failed | refunded"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          },
          "item": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineEvent"
            },
            "type": "array",
            "title": "Timeline"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "amount",
          "item",
          "timeline"
        ],
        "title": "DonationStatus"
      },
      "GiftCardRequest": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 500.0,
                "minimum": 10.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount",
            "description": "USD",
            "examples": [
              50
            ]
          },
          "buyer_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Buyer Name",
            "description": "Shown as a supporter"
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "GiftCardRequest"
      },
      "GiftCardStatus": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "business": {
            "type": "string",
            "title": "Business"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "active | refunded"
          },
          "face_value": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Face Value"
          },
          "balance": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Balance"
          },
          "usable_now": {
            "type": "boolean",
            "title": "Usable Now"
          }
        },
        "type": "object",
        "required": [
          "code",
          "business",
          "status",
          "face_value",
          "balance",
          "usable_now"
        ],
        "title": "GiftCardStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PriceReport": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "seller": {
            "type": "string",
            "title": "Seller"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "channel3 (online) | local_survey (demo data)"
          },
          "baseline_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Price",
            "description": "Median price in the 30 days before the declaration"
          },
          "current_price": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Price"
          },
          "markup_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Markup Percent"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ok | gouging | no_baseline | unknown"
          }
        },
        "type": "object",
        "required": [
          "title",
          "seller",
          "category",
          "source",
          "baseline_price",
          "current_price",
          "markup_percent",
          "status"
        ],
        "title": "PriceReport"
      },
      "RegistryDetail": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug",
            "examples": [
              "rivera-family"
            ]
          },
          "title": {
            "type": "string",
            "title": "Title",
            "examples": [
              "Help the Riveras come home"
            ]
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "open_items": {
            "type": "integer",
            "title": "Open Items"
          },
          "still_needed": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Still Needed",
            "description": "Sum of what open items still need, in USD"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The registry's public page"
          },
          "story": {
            "type": "string",
            "title": "Story"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RegistryItemInfo"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "title",
          "city",
          "state",
          "open_items",
          "still_needed",
          "url",
          "story",
          "items"
        ],
        "title": "RegistryDetail"
      },
      "RegistryItemInfo": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Twin mattresses"
            ]
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "examples": [
              "bedding"
            ]
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "target_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Target Amount",
            "description": "Total needed for this item, in USD"
          },
          "funded_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Funded Amount"
          },
          "remaining": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Remaining"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "open | funded | purchased | delivered"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "note",
          "category",
          "quantity",
          "target_amount",
          "funded_amount",
          "remaining",
          "status"
        ],
        "title": "RegistryItemInfo"
      },
      "RegistrySummary": {
