# Copy to backend/.env and fill in. Never commit .env.

# --- LLM providers. Fill in at least one. ---
# Google AI Studio free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# OpenRouter (https://openrouter.ai/settings/keys). Free models: 50 requests/day without credits.
OPENROUTER_API_KEY=
# `provider:model` fallback list, tried in order. Providers without a key are skipped.
AI_MODELS=gemini:gemini-flash-lite-latest,gemini:gemma-4-31b-it,openrouter:google/gemma-4-31b-it:free,openrouter:openrouter/free

# --- Channel3 (https://trychannel3.com/dashboard) ---
CHANNEL3_API_KEY=

# --- PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox) ---
# App features: Payouts, Subscriptions, Customer disputes, Invoicing, Transaction search, Vault, and Log in with
# PayPal (return URL http://localhost:5173/connect/paypal; add the deployed web app's /connect/paypal too).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
# Log in with PayPal return URL, exactly as saved in the app's settings. PayPal won't save localhost, so locally
# save https://example.com/connect/paypal there and here (the e2e check forwards it); leave empty when deployed.
PAYPAL_CONNECT_RETURN_URL=
# The sandbox buyer (personal) account, for the e2e checks that pay or sign in at PayPal.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Sandbox test accounts (https://developer.paypal.com/dashboard/accounts), used by the spikes.
PAYPAL_SANDBOX_RETAILER_EMAIL=
PAYPAL_SANDBOX_PAYOUT_RECEIVERS=household@example.com,volunteer@example.com,contractor@example.com

# --- Infrastructure (set automatically on Render) ---
# Empty = local SQLite file (backend/hearthline.db). Render sets a Postgres URL.
DATABASE_URL=
